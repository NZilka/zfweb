# Copy this file to .env.local (gitignored) and populate the values.
# .env.local is the single source of truth for local dev — Next.js, drizzle-kit,
# and node scripts all read from it (see drizzle.config.ts, src/server/db/index.ts,
# scripts/test-kv.ts). Keep this example file in sync with the keys you use.
#
# When adding additional environment variables, update the schema in /src/env.js
# so the build fails fast on misconfiguration.

# ─── Database ───────────────────────────────────────────────────────────
# Neon Postgres pooled connection. Point at the STAGING Neon branch for local
# dev; only swap to the prod URL when running `pnpm db:push` against prod after
# a release PR has landed on main.
DATABASE_URL="postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# ─── Authentication (Clerk) ─────────────────────────────────────────────
# Get from the Clerk dashboard. Shared between prod and staging.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─── Payments (Stripe — TEST mode) ──────────────────────────────────────
# Test-mode keys for local dev. Prod uses live keys in Vercel only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── KV cache (Upstash Redis) ───────────────────────────────────────────
# Separate Upstash DB per environment (prod / staging / local). KV stores
# SiteSettings (carousel, logos, test-mode flag) — sharing would cross-contaminate.
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-token>"

# ─── File uploads (UploadThing) ─────────────────────────────────────────
# SDK auto-reads UPLOADTHING_TOKEN from process.env.
UPLOADTHING_TOKEN="<your-token>"

# ─── Runtime gates ──────────────────────────────────────────────────────
# Capability gate for admin test mode. See docs/STAGING_SETUP.md.
# - "true" on staging and local dev (unlocks admin test mode toggle)
# - Omit or "false" in production (test mode cannot run)
TEST_MODE_ALLOWED="false"

# ─── Analytics (PostHog — optional) ─────────────────────────────────────
# Set in Vercel only (skipped on preview/staging deploys). Leave blank locally.
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# POSTHOG_API_KEY="phc_..."

# ─── Vercel system env vars (auto-injected on Vercel deploys) ───────────
# Do not set these locally. Listed for reference.
# VERCEL_ENV - "production" | "preview" | "development"
# VERCEL_GIT_COMMIT_REF - branch name of the current deploy
# NEXT_PUBLIC_VERCEL_ENV - Next.js auto-exposed copy for client-side use
