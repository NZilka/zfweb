# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/zfweb"

# Stripe (get from Stripe Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Upstash Redis (get from Upstash Console)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Test mode capability gate. See docs/STAGING_SETUP.md.
# - "true" on staging and local dev (unlocks admin test mode toggle in /admin/settings)
# - Omit or "false" in production (test mode cannot run)
TEST_MODE_ALLOWED="false"

# Vercel system environment variables (auto-injected on Vercel deploys, do not set locally)
# VERCEL_ENV - "production" | "preview" | "development"
# VERCEL_GIT_COMMIT_REF - branch name of the current deploy
# NEXT_PUBLIC_VERCEL_ENV - Next.js auto-exposed copy for client-side use
